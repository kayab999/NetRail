{
  "description": "Shared open-URL and backend-URL policy vectors for Rust + Python. Expect allow or block with stable code.",
  "open_url": [
    {
      "id": "accept_https",
      "url": "https://example.com/path",
      "expect": "allow",
      "normalized": "https://example.com/path"
    },
    {
      "id": "reject_javascript",
      "url": "javascript:alert(1)",
      "expect": "block",
      "code": "OPEN_URL_INVALID_SCHEME"
    },
    {
      "id": "reject_localhost",
      "url": "http://127.0.0.1:8080/admin",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_decimal_loopback",
      "url": "http://2130706433/",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_hex_loopback",
      "url": "http://0x7f000001/",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_octal_loopback",
      "url": "http://0177.0.0.1/",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_short_loopback",
      "url": "http://127.1/",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_private_rfc1918",
      "url": "http://192.168.1.1/",
      "expect": "block",
      "code": "OPEN_URL_PRIVATE"
    },
    {
      "id": "reject_nip_io_subdomain",
      "url": "http://127.0.0.1.nip.io/",
      "expect": "block",
      "code": "OPEN_URL_DNS_REBINDING"
    },
    {
      "id": "reject_localtest_me_apex",
      "url": "http://localtest.me/",
      "expect": "block",
      "code": "OPEN_URL_DNS_REBINDING"
    },
    {
      "id": "reject_nip_io_apex",
      "url": "http://nip.io/",
      "expect": "block",
      "code": "OPEN_URL_DNS_REBINDING"
    },
    {
      "id": "reject_sslip_io_apex",
      "url": "http://sslip.io/",
      "expect": "block",
      "code": "OPEN_URL_DNS_REBINDING"
    },
    {
      "id": "reject_xip_io_apex",
      "url": "http://xip.io/",
      "expect": "block",
      "code": "OPEN_URL_DNS_REBINDING"
    },
    {
      "id": "ddg_unwrap_blocks_localhost",
      "url": "https://duckduckgo.com/l/?uddg=http%3A%2F%2F127.0.0.1%2Fapi",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "duck_com_unwrap_blocks_localhost",
      "url": "https://duck.com/l/?uddg=http%3A%2F%2F127.0.0.1%2F",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "www_ddg_unwrap_blocks_localhost",
      "url": "https://www.duckduckgo.com/l/?uddg=http%3A%2F%2F127.0.0.1%2F",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "ddg_unwrap_safe",
      "url": "https://duckduckgo.com/l/?uddg=https%3A%2F%2Frust-lang.org%2F",
      "expect": "allow",
      "normalized": "https://rust-lang.org/"
    },
    {
      "id": "duck_com_unwrap_safe",
      "url": "https://duck.com/l/?uddg=https%3A%2F%2Fexample.com%2Fdoc",
      "expect": "allow",
      "normalized": "https://example.com/doc"
    },
    {
      "id": "reject_credentials",
      "url": "https://user:pass@example.com/",
      "expect": "block",
      "code": "OPEN_URL_CREDENTIALS"
    },
    {
      "id": "reject_ipv4_mapped_loopback",
      "url": "http://[::ffff:127.0.0.1]/",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_ipv4_mapped_private",
      "url": "http://[::ffff:c0a8:101]/",
      "expect": "block",
      "code": "OPEN_URL_PRIVATE"
    },
    {
      "id": "reject_metadata_hostname_open",
      "url": "http://metadata.google.internal/",
      "expect": "block",
      "code": "OPEN_URL_CLOUD_METADATA"
    },
    {
      "id": "reject_trailing_dot_loopback",
      "url": "http://127.0.0.1./admin",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_decimal_loopback",
      "url": "http://2130706433./",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_short_loopback",
      "url": "http://127.1./",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_hex_loopback",
      "url": "http://0x7f.0.0.1./",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_octal_loopback",
      "url": "http://127.000.000.001./",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_loopback_port",
      "url": "http://127.0.0.1.:8080/admin",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_trailing_dot_private",
      "url": "http://192.168.1.1./",
      "expect": "block",
      "code": "OPEN_URL_PRIVATE"
    },
    {
      "id": "reject_trailing_dot_private_10",
      "url": "http://10.0.0.1./",
      "expect": "block",
      "code": "OPEN_URL_PRIVATE"
    },
    {
      "id": "ddg_unwrap_trailing_dot_blocks_localhost",
      "url": "https://duckduckgo.com./l/?uddg=http%3A%2F%2F127.0.0.1%2F",
      "expect": "block",
      "code": "OPEN_URL_LOCALHOST"
    },
    {
      "id": "reject_malformed_ipv6_bracket",
      "url": "http://[::ffff:7f00:1]./",
      "expect": "block",
      "code": "OPEN_URL_INVALID"
    }
  ],
  "backend_url": [
    {
      "id": "allow_localhost_searxng",
      "url": "http://127.0.0.1:8080",
      "expect": "allow",
      "normalized": "http://127.0.0.1:8080"
    },
    {
      "id": "allow_private_lan_searxng",
      "url": "http://192.168.0.5:8080",
      "expect": "allow",
      "normalized": "http://192.168.0.5:8080"
    },
    {
      "id": "reject_metadata_ip",
      "url": "http://169.254.169.254/latest/meta-data/",
      "expect": "block",
      "code": "BACKEND_URL_CLOUD_METADATA"
    },
    {
      "id": "reject_nip_io_backend",
      "url": "http://127.0.0.1.nip.io/",
      "expect": "block",
      "code": "BACKEND_URL_DNS_REBINDING"
    },
    {
      "id": "reject_localtest_me_apex_backend",
      "url": "http://localtest.me/",
      "expect": "block",
      "code": "BACKEND_URL_DNS_REBINDING"
    },
    {
      "id": "reject_nip_io_apex_backend",
      "url": "http://nip.io/",
      "expect": "block",
      "code": "BACKEND_URL_DNS_REBINDING"
    },
    {
      "id": "reject_aws_ipv6_metadata",
      "url": "http://[fd00:ec2::254]/",
      "expect": "block",
      "code": "BACKEND_URL_CLOUD_METADATA"
    },
    {
      "id": "reject_metadata_hostname_backend",
      "url": "http://metadata.google.internal/",
      "expect": "block",
      "code": "BACKEND_URL_CLOUD_METADATA"
    },
    {
      "id": "reject_strict_trailing_dot_loopback_backend",
      "url": "http://127.0.0.1.:8080",
      "expect": "block",
      "code": "BACKEND_URL_STRICT_PRIVATE",
      "strict": true
    },
    {
      "id": "reject_strict_trailing_dot_private_backend",
      "url": "http://192.168.1.1.:8080",
      "expect": "block",
      "code": "BACKEND_URL_STRICT_PRIVATE",
      "strict": true
    },
    {
      "id": "allow_trailing_dot_localhost_backend_nonstrict",
      "url": "http://127.0.0.1.:8080",
      "expect": "allow",
      "normalized": "http://127.0.0.1.:8080"
    }
  ]
}
