{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetRail",
  "mainBinaryName": "netrail",
  "version": "1.6.5",
  "identifier": "io.netrail.NetRail",
  "build": {
    "frontendDist": "../netrail/static",
    "devUrl": "http://127.0.0.1:7421",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NetRail",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "url": "http://127.0.0.1:7421"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://127.0.0.1:7421 ws://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local research console — search first, browse second",
    "longDescription": "NetRail is a privacy-first local research console for Linux. Fanout search across backends you enable, merge results on your machine, and open links only when you choose. Zero telemetry. Localhost API only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/netrail.desktop.hbs",
        "section": "web",
        "files": {
          "/usr/share/netrail/static/": "../netrail/static/",
          "/usr/share/netrail/SBOM.txt": "sbom/SBOM.txt"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/netrail.desktop.hbs",
        "files": {
          "/usr/share/netrail/SBOM.txt": "sbom/SBOM.txt"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/share/netrail/static/": "../netrail/static/",
          "usr/share/netrail/SBOM.txt": "sbom/SBOM.txt"
        }
      }
    }
  },
  "plugins": {}
}