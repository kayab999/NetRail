# Generate a Fernet key (required for Docker — no OS keyring in containers):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETRAIL_DB_KEY=

# Required for headless/Docker: the API refuses to start without it.
# Generate with: openssl rand -hex 32
# For localhost-only testing/CI, set explicitly empty (runs WITHOUT auth + warning):
# NETRAIL_API_TOKEN=
NETRAIL_API_TOKEN=change-me-generate-with-openssl-rand-hex-32

# Optional: point NetRail at a SearXNG instance (e.g. docker compose --profile searxng up)
SEARXNG_URL=http://searxng:8080